@@ -0,0 +1,68 @@
+﻿import asyncio
+import json
+
+from index import Default
+import middleware
+
+
+class Request:
+    def __init__(self, method, path, headers=None):
+        self.method = method
+        self.url = f"https://example.test{path}"
+        self.headers = headers or {}
+
+
+def fetch(method, path, headers=None):
+    return asyncio.run(Default().fetch(Request(method, path, headers)))
+
+
+def test_broker_list_route():
+    response = fetch("GET", "/api/brokers")
+
+    assert response.status == 200
+    assert len(json.loads(response.text)) > 0
+
+
+def test_broker_detail_route():
+    response = fetch("GET", "/api/brokers/whitepages")
+
+    assert response.status == 200
+    assert json.loads(response.text)["id"] == "whitepages"
+
+
+def test_unknown_broker_route_returns_404():
+    response = fetch("GET", "/api/brokers/unknown-broker")
+
+    assert response.status == 404
+
+
+def test_options_request_bypasses_rate_limit():
+    middleware._ip_requests["192.0.2.10"] = [
+        100.0
+    ] * middleware.MAX_REQUESTS_PER_WINDOW
+
+    response = fetch(
+        "OPTIONS",
+        "/api/brokers",
+        {"cf-connecting-ip": "192.0.2.10"},
+    )
+
+    assert response.status == 200
+    assert response.headers["Access-Control-Allow-Methods"] == "GET, OPTIONS"
+
+
+def test_unknown_path_returns_404():
+    response = fetch("GET", "/not-a-real-route")
+
+    assert response.status == 404
+    assert response.text == "Not Found"
+
+
+def test_alert_route_rejects_wrong_content_type():
+    response = fetch(
+        "POST",
+        "/api/alerts",
+        {"cf-connecting-ip": "192.0.2.11", "content-type": "text/plain"},
+    )
+
+    assert response.status == 400
diff --git a/blt-vanish/cloudflare_workers/tests/test_middleware.py b/blt-vanish/cloudflare_workers/tests/test_middleware.py
new file mode 100644
index 0000000000..4d86e9bfa8
--- /dev/null
+++ b/blt-vanish/cloudflare_workers/tests/test_middleware.py
@@ -0,0 +1,55 @@
+﻿import middleware
+
+
+class Request:
+    def __init__(self, headers=None, method="GET"):
+        self.headers = headers or {}
+        self.method = method
+
+
+def test_rate_limit_allows_first_100_requests():
+    request = Request({"cf-connecting-ip": "192.0.2.1"})
+
+    for _ in range(middleware.MAX_REQUESTS_PER_WINDOW):
+        assert middleware.rate_limit_middleware(request) is None
+
+
+def test_rate_limit_rejects_request_101():
+    request = Request({"cf-connecting-ip": "192.0.2.2"})
+
+    for _ in range(middleware.MAX_REQUESTS_PER_WINDOW):
+        assert middleware.rate_limit_middleware(request) is None
+
+    response = middleware.rate_limit_middleware(request)
+
+    assert response.status == 429
+    assert "Too Many Requests" in response.text
+    assert response.headers["Access-Control-Allow-Origin"] == "*"
+
+
+def test_rate_limit_uses_forwarded_ip_when_cf_ip_missing():
+    request = Request({"x-forwarded-for": "192.0.2.3"})
+
+    assert middleware.rate_limit_middleware(request) is None
+    assert "192.0.2.3" in middleware._ip_requests
+
+
+def test_alert_post_requires_json_content_type():
+    request = Request({"content-type": "text/plain"}, method="POST")
+
+    response = middleware.alert_routing_middleware(request, "/api/alerts")
+
+    assert response.status == 400
+    assert "Invalid Content-Type" in response.text
+
+
+def test_alert_put_accepts_json_content_type():
+    request = Request({"content-type": "application/json"}, method="PUT")
+
+    assert middleware.alert_routing_middleware(request, "/api/alerts") is None
+
+
+def test_non_alert_post_does_not_require_json_content_type():
+    request = Request({"content-type": "text/plain"}, method="POST")
+
+    assert middleware.alert_routing_middleware(request, "/api/brokers") is None
