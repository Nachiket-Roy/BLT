+before="$(total "$data")"
 before="${before:-0}"
 
-OUTPUT_FILE="$page" "$PYTHON" generate_repo_list.py
+OUTPUT_FILE="$data" "$PYTHON" generate_repo_list.py
 
-after="$(total "$page")"
+after="$(total "$data")"
 after="${after:-0}"
 if (( after == 0 || after * 2 < before )); then
-  echo "not writing index.html: $after repositories (was $before)" >&2
+  echo "not writing data/repos.json: $after repositories (was $before)" >&2
