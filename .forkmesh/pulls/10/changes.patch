-        function getYearsSinceUpdate(dateStr) {{
-            if (!dateStr) return 0;
-            const lastUpdate = new Date(dateStr);
-            const now = new Date();
-            const diffTime = now - lastUpdate;
-            const diffYears = diffTime / (1000 * 60 * 60 * 24 * 365.25);
-            return diffYears;
-        }}
