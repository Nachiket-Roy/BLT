+    pill: `<a class="rem rem-${status} rem-inline" href="${escapeHtml(safeUrl(rem.url))}" target="_blank" rel="noopener" title="${escapeHtml(title)}">${escapeHtml(top)} · ${escapeHtml(status === "closed" ? "closed" : replies)}</a>`,
