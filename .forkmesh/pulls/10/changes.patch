 cd "$(dirname "$0")/.."
 ROOT="$(git rev-parse --show-toplevel)"
 PYTHON="${PYTHON:-python3}"
 PUB="${PUBLIC_DIR:-public}"
-page="$PUB/index.html"
+data="$PUB/data/repos.json"
 
-total() { grep -o 'Total: [0-9]* repositories' "$1" 2>/dev/null | head -1 | tr -dc '0-9' || true; }
-before="$(total "$page")"
