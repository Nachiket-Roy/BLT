+        form.severity = "Critical".to_string();
+        let mut seen = vec![];
+        for _ in 0..5 {
+            form.cycle_selector(false);
+            seen.push(form.severity.clone());
+        }
+        assert_eq!(seen, ["Low", "Medium", "High", "Critical", "Low"]);
+    }
+
+    #[test]
