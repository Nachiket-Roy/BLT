From ddf370d794ee241e50ff59dd68c77655206d0776 Mon Sep 17 00:00:00 2001
From: Vanshika <pahalvanshikaa@gmail.com>
Date: Fri, 23 Oct 2026 14:25:24 +0530
Subject: [PATCH] blt-vanish: rename remaining SelfErase references to BLT
 Vanish

Rename SelfEraseApp to BLTVanishApp and update the app title, welcome
text and about dialog in blt-vanish-flutter, plus the README and the
broker schema title and description. Package name, schema keys and
endpoints are unchanged.

Fixes #36

Signed-off-by: Vanshika <pahalvanshikaa@gmail.com>
---
 blt-vanish-flutter/lib/main.dart                | 8 ++++----
 blt-vanish-flutter/lib/screens/home_screen.dart | 8 ++++----
 blt-vanish/README.md                            | 2 +-
 blt-vanish/data/schema.json                     | 4 ++--
 4 files changed, 11 insertions(+), 11 deletions(-)

diff --git a/blt-vanish-flutter/lib/main.dart b/blt-vanish-flutter/lib/main.dart
index 6cf9dffcb0..2dc5f3cfd5 100644
--- a/blt-vanish-flutter/lib/main.dart
+++ b/blt-vanish-flutter/lib/main.dart
@@ -19,18 +19,18 @@ void main() async {
         Provider<StorageService>.value(value: storageService),
         Provider<BrokerService>.value(value: brokerService),
       ],
-      child: const SelfEraseApp(),
+      child: const BLTVanishApp(),
     ),
   );
 }
 
-class SelfEraseApp extends StatelessWidget {
-  const SelfEraseApp({super.key});
+class BLTVanishApp extends StatelessWidget {
+  const BLTVanishApp({super.key});
 
   @override
   Widget build(BuildContext context) {
     return MaterialApp(
-      title: 'SelfErase',
+      title: 'BLT Vanish',
       debugShowCheckedModeBanner: false,
       theme: ThemeData(
         colorScheme: ColorScheme.fromSeed(
