+++ b/blt-api/src/handlers/health.py
@@ -2,42 +2,62 @@
 Health check handler.
 """
 
-from typing import Any, Dict
+from typing import Any, Dict,Callable
 from workers import Response
+from router import Router
 
 
-async def handle_health(
-    request: Any,
-    env: Any,
-    path_params: Dict[str, str],
-    query_params: Dict[str, str],
-    path: str
-) -> Any:
+
+
+def make_health_handler(router: Router) -> Callable:
     """
-    Handle health check requests.
-    
-    Returns API status and version information.
+    Create a routes handler with access to the router instance.
+
+    This factory pattern avoids circular imports by accepting the router
+    as a parameter rather than importing it from main.
+
+    Args:
+        router: The Router instance to query for registered routes
+
+    Returns:
+        An async handler function for the /routes endpoint
     """
-    return Response.json({
-        "status": "healthy",
-        "api": "BLT API",
-        "version": "1.0.0",
-        "documentation": "/docs",
-        "endpoints": {
-            "bugs": "/bugs",
-            "users": "/users",
-            "domains": "/domains",
-            "organizations": "/organizations",
-            "projects": "/projects",
-            "hunts": "/hunts",
-            "stats": "/stats",
-            "leaderboard": "/leaderboard",
-            "contributors": "/contributors",
-            "repos": "/repos"
-        },
-        "links": {
-            "github": "https://git.owaspblt.org/BLT/BLT-Core",
-            "website": "https://owaspblt.org",
-            "documentation": "https://git.owaspblt.org/BLT/BLT-API"
-        }
-    })
+    async def handle_health(
+        request: Any,
+        env: Any,
+        path_params: Dict[str, str],
+        query_params: Dict[str, str],
+        path: str
+    ) -> Any:
+        """
+        Handle health check requests.
+
+        Returns API status and version information.
+        """
+
+        routes = router.get_route_list()
+        endpoints = {}
+        registered_paths = {route["path"] for route in routes}
+        for route in routes:
+            route_path = route["path"]
+            if route_path.startswith("/v2"):
+                continue
+            segment = route_path.strip("/").split("/")[0]
+            candidate = f"/{segment}"
+            if segment and segment not in ("", "{id}") and candidate in registered_paths:
+                endpoints[segment] = candidate
+
+        return Response.json({
+            "status": "healthy",
+            "api": "BLT API",
+            "version": "1.0.0",
+            "documentation": "/dashboard",
+            "endpoints": endpoints,
+            "links": {
+                "github": "https://git.owaspblt.org/BLT/BLT-Core",
+                "website": "https://owaspblt.org",
+                "documentation": "https://git.owaspblt.org/BLT/BLT-API"
+            }
+        })
+
+    return handle_health
