@@ -0,0 +1,83 @@
+"""
+Tests for the BLT API health check handler.
+"""
+
+import importlib
+import sys
+import types
+from pathlib import Path
+
+import pytest
+
+# Add src to path for imports to work
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))
+
+from router import Router
+from handlers.health import make_health_handler
+
+
+class MockRequest:
+    """Mock request object for testing."""
+
+    def __init__(self, url="https://blt-api.workers.dev/health"):
+        self.url = url
+        self.method = "GET"
+
+
+class MockEnv:
+    """Mock environment object for testing."""
+    pass
+
+
+class TestHealthHandler:
+    """Tests for the /health endpoint."""
+
+    @pytest.mark.asyncio
+    async def test_health_returns_expected_status_fields(self):
+        router = Router()
+        handler = make_health_handler(router)
+
+        response = await handler(
+            MockRequest(),
+            MockEnv(),
+            path_params={},
+            query_params={},
+            path="/health",
+        )
+
+        import json
+        body = json.loads(response.body)
+        assert body["status"] == "healthy"
+        assert body["api"] == "BLT API"
+        assert body["documentation"] == "/dashboard"
+
+    @pytest.mark.asyncio
+    async def test_health_every_listed_endpoint_is_a_registered_route(self, monkeypatch):
+        previous_workers = sys.modules.get("workers")
+        workers_mod = types.ModuleType("workers")
+
+        class WorkerEntrypoint:
+            pass
+
+        setattr(workers_mod, "WorkerEntrypoint", WorkerEntrypoint)
+        with monkeypatch.context() as patch_context:
+            patch_context.setitem(sys.modules, "workers", workers_mod)
+            main = importlib.reload(sys.modules["main"]) if "main" in sys.modules else importlib.import_module("main")
+
+            registered_paths = {route.pattern for route in main.router.routes}
+
+            handler = make_health_handler(main.router)
+            response = await handler(
+                MockRequest(),
+                MockEnv(),
+                path_params={},
+                query_params={},
+                path="/health",
+            )
+
+            import json
+            body = json.loads(response.body)
+            for name, endpoint_path in body["endpoints"].items():
+                assert endpoint_path in registered_paths, f"{name} -> {endpoint_path} is not a registered route"
+
+        assert sys.modules.get("workers") is previous_workers
