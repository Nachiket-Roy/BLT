index 0000000000..40b4d23328
--- /dev/null
+++ b/blt-toasty/scripts/diagnose_blt_chat_webhook.py
@@ -0,0 +1,83 @@
+"""Compare curl and urllib delivery to a BLT Chat webhook.
+
+The webhook URL is read from BLT_CHAT_WEBHOOK_URL and is never printed.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import urllib.error
+import urllib.request
+
+
+PAYLOAD = json.dumps({"text": "Toasty webhook transport diagnostic"})
+
+
+def curl_result(webhook_url: str, user_agent: str | None = None) -> tuple[str, str]:
+    command = [
+        "curl",
+        "--silent",
+        "--show-error",
+        "--output",
+        "/private/tmp/toasty-chat-curl-body.txt",
+        "--write-out",
+        "%{http_code}",
+        "--request",
+        "POST",
+        webhook_url,
+        "--header",
+        "Content-Type: application/json",
+        "--data",
+        PAYLOAD,
+    ]
+    if user_agent:
+        command.extend(["--user-agent", user_agent])
+    result = subprocess.run(command, check=False, capture_output=True, text=True)  # nosec B603
+    try:
+        with open("/private/tmp/toasty-chat-curl-body.txt", encoding="utf-8") as body_file:
+            body = body_file.read()
+    except FileNotFoundError:
+        body = result.stderr
+    return result.stdout.strip() or f"curl-exit-{result.returncode}", body.strip()
+
+
+def urllib_result(webhook_url: str, user_agent: str | None = None) -> tuple[str, str]:
+    headers = {"Content-Type": "application/json"}
+    if user_agent:
+        headers["User-Agent"] = user_agent
+    request = urllib.request.Request(
+        webhook_url,
+        data=PAYLOAD.encode("utf-8"),
+        headers=headers,
+        method="POST",
+    )
+    try:
+        with urllib.request.urlopen(request, timeout=15) as response:  # nosec B310
+            return str(response.status), response.read().decode("utf-8", errors="replace")
+    except urllib.error.HTTPError as error:
+        return str(error.code), error.read().decode("utf-8", errors="replace")
+    except urllib.error.URLError as error:
+        return "connection-error", str(error.reason)
+
+
+def main() -> None:
+    webhook_url = os.environ.get("BLT_CHAT_WEBHOOK_URL")
+    if not webhook_url:
+        raise SystemExit("BLT_CHAT_WEBHOOK_URL is not set in this terminal.")
+
+    checks = [
+        ("curl default", lambda: curl_result(webhook_url)),
+        ("curl Python UA", lambda: curl_result(webhook_url, "Python-urllib/3.14")),
+        ("urllib default", lambda: urllib_result(webhook_url)),
+        ("urllib custom UA", lambda: urllib_result(webhook_url, "Toasty-Notifier-Proof/1.0")),
+    ]
+    for label, check in checks:
+        status, body = check()
+        print(f"{label}: HTTP {status}")
+        print(f"  body: {body[:300]}")
+
+
+if __name__ == "__main__":
+    main()
