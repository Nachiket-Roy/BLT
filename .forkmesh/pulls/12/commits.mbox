+class _Statement:
+    def __init__(self, result):
+        self.result = result
+        self.bound = None
+
+    def bind(self, *args):
+        self.bound = args
+        return self
+
+    async def first(self):
+        return self.result
+
+
+class _NotifierDb:
+    def __init__(self):
+        self.queries = []
+
+    def prepare(self, query):
+        self.queries.append(query)
+        if "triage_summaries" in query:
+            return _Statement({"cwe_hints": '["CWE-79"]'})
+        return _Statement({"candidate_event_id": "evt-existing", "similarity_score": 0.91})
+
+
+@pytest.mark.asyncio
+async def test_exported_notification_uses_summary_cwes_and_confirmed_duplicate_only():
+    fetch_mock = AsyncMock(return_value=SimpleNamespace(ok=True, status=200))
+    env = SimpleNamespace(BLT_CHAT_WEBHOOK_URL="https://git.owaspblt.org/hooks/test", _fetch_impl=fetch_mock)
+    db = _NotifierDb()
+
+    delivered = await notify_triage_exported(db, EVENT, env)
+
+    assert delivered is True
+    assert any("cwe_hints" in query for query in db.queries)
+    assert any("llm_confirmed = 1" in query for query in db.queries)
+    payload = json.loads(fetch_mock.await_args.args[1]["body"])
+    assert "CWE-79" in _all_text(payload)
+    assert "evt-existing" in _all_text(payload)
