+"""Post safe Toasty notification examples to a BLT Chat test channel.
+
+Usage:
+    BLT_CHAT_WEBHOOK_URL='https://...' python scripts/test_blt_chat_notifier.py
+
+The webhook URL is intentionally read only from the environment so it cannot
+be accidentally committed with this proof helper.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
+from notifier import format_quarantine_notification, format_triage_notification
+
+
+def post(webhook_url: str, payload: dict) -> None:
+    # Curl is used because it is the transport manually verified against BLT
+    # Chat. The earlier urllib 403 is diagnosed separately; production delivery
+    # remains Workers-native fetch() in src/notifier.py.
+    result = subprocess.run(  # nosec B603 - fixed executable and argument list
+        [
+            "curl",
+            "--fail-with-body",
+            "--silent",
+            "--show-error",
+            "--request",
+            "POST",
+            webhook_url,
+            "--header",
+            "Content-Type: application/json",
+            "--data",
+            json.dumps(payload),
+        ],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    if result.returncode:
+        raise RuntimeError(result.stderr.strip() or "curl could not deliver the notification")
+
+
+def main() -> None:
+    webhook_url = os.environ.get("BLT_CHAT_WEBHOOK_URL")
+    if not webhook_url:
+        raise SystemExit("Set BLT_CHAT_WEBHOOK_URL before running this script.")
+
+    event = {"id": "proof-triage-001", "project_id": "toasty-demo", "issue_iid": 42}
+    post(
+        webhook_url,
+        format_triage_notification(
+            event,
+            ["CWE-79", "CWE-89"],
+            {"candidate_event_id": "existing-issue-17", "similarity_score": 0.91},
+        ),
+    )
+    post(
+        webhook_url,
+        format_quarantine_notification(
+            {"id": "proof-quarantine-002", "project_id": "toasty-demo", "issue_iid": 43},
+            "Residual PII after Markdown stripping: 1 entities",
+        ),
+    )
+    print("Sent triage and quarantine proof notifications to BLT Chat.")
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except RuntimeError as error:
+        raise SystemExit(f"Could not deliver BLT Chat proof notifications: {error}") from error
diff --git a/blt-toasty/src/notifier.py b/blt-toasty/src/notifier.py
new file mode 100644
index 0000000000..9a9f3ed249
--- /dev/null
+++ b/blt-toasty/src/notifier.py
@@ -0,0 +1,175 @@
+"""BLT Chat notifications for terminal Toasty triage states.
+
+The module deliberately contains no raw issue text.  Notifications are built
+only from the persisted event identifiers, CWE hints, and confirmed duplicate
+metadata so a chat delivery cannot expose an unredacted report.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any
+
+logger = logging.getLogger("toasty.notifier")
+
+try:
+    from js import AbortSignal, fetch  # type: ignore[import-not-found]
+except ImportError:
+    AbortSignal = None  # type: ignore[assignment]
+    fetch = None  # type: ignore[assignment]
+
+
+NOTIFICATION_TIMEOUT_MS = 5_000
+
+
+def _get_value(row: Any, key: str, default: Any = None) -> Any:
+    """Read a field from D1's dict-like rows without leaking runtime details."""
+    if row is None:
+        return default
+    if hasattr(row, "to_py"):
+        row = row.to_py()
+    if hasattr(row, "get"):
+        return row.get(key, default)
+    return getattr(row, key, default)
+
+
+def _escape_markdown(value: Any) -> str:
+    """Escape untrusted values before putting them in BLT Chat Markdown text."""
+    return (
+        str(value if value is not None else "unknown")
+        .replace("&", "&amp;")
+        .replace("<", "&lt;")
+        .replace(">", "&gt;")
+    )
+
+
+def format_triage_notification(event: dict[str, Any], cwe_hints: list[str], duplicate: dict[str, Any] | None) -> dict:
+    """Build the pure, privacy-safe BLT Chat webhook payload for an exported event."""
+    cwe_text = ", ".join(_escape_markdown(cwe) for cwe in cwe_hints) if cwe_hints else "unknown"
+    duplicate_text = "none"
+    if duplicate:
+        candidate_id = _escape_markdown(duplicate.get("candidate_event_id"))
+        score = duplicate.get("similarity_score")
+        try:
+            duplicate_text = f"confirmed `{candidate_id}` ({float(score):.2f})"
+        except (TypeError, ValueError):
+            duplicate_text = f"confirmed `{candidate_id}`"
+
+    text = "\n".join(
+        [
+            "#### Toasty triage completed",
+            f"**Event:** `{_escape_markdown(event.get('id'))}`",
+            f"**Project / issue:** {_escape_markdown(event.get('project_id'))} / !{_escape_markdown(event.get('issue_iid'))}",
+            f"**CWE:** {cwe_text}",
+            "**Severity:** unknown (not assessed)",
+            f"**Duplicate finding:** {duplicate_text}",
+        ]
+    )
+    return {"text": text}
+
+
+def _safe_quarantine_reason(reason: str) -> str:
+    """Classify stored reasons without copying exception or report text to chat."""
+    normalized = reason.lower()
+    if "residual pii" in normalized:
+        return "Residual PII detected"
+    if "confidence" in normalized and "entity" in normalized:
+        return "PII confidence below threshold"
+    return "Safety check failed — inspect protected audit log"
+
+
+def format_quarantine_notification(event: dict[str, Any], reason: str) -> dict:
+    """Build the deliberately thin BLT Chat webhook payload for quarantine."""
+    safe_reason = _safe_quarantine_reason(reason)
+    text = "\n".join(
+        [
+            "#### Toasty safety quarantine",
+            f"**Event:** `{_escape_markdown(event.get('id'))}`",
+            f"**Project / issue:** {_escape_markdown(event.get('project_id'))} / !{_escape_markdown(event.get('issue_iid'))}",
+            "**PII / safety quarantine:** yes",
+            f"**Reason:** {safe_reason}",
+        ]
+    )
+    return {"text": text}
+
+
+def _parse_cwe_hints(value: Any) -> list[str]:
+    """Return valid, display-safe CWE strings from the JSON D1 column."""
+    if isinstance(value, str):
+        try:
+            value = json.loads(value)
+        except json.JSONDecodeError:
+            return []
+    if not isinstance(value, list):
+        return []
+    return [str(cwe) for cwe in value if isinstance(cwe, str) and cwe.startswith("CWE-")]
+
+
+async def deliver_chat_notification(payload: dict, env: Any, event_id: str) -> bool:
+    """Deliver a payload without allowing BLT Chat failures to affect triage."""
+    webhook_url = getattr(env, "BLT_CHAT_WEBHOOK_URL", None) if env is not None else None
+    if not isinstance(webhook_url, str) or not webhook_url.strip():
+        return False
+
+    fetch_impl = fetch or getattr(env, "_fetch_impl", None)
+    if fetch_impl is None:
+        logger.warning("BLT Chat notification unavailable for event %s: fetch is not configured", event_id)
+        return False
+
+    try:
+        options = {
+            "method": "POST",
+            "headers": {"Content-Type": "application/json"},
+            "body": json.dumps(payload),
+        }
+        # Use the browser-native timeout rather than passing a Python callback
+        # into JavaScript's setTimeout. Pyodide can release that callback before
+        # it fires, leaving a hung fetch without a cancellation path.
+        if AbortSignal is not None:
+            options["signal"] = AbortSignal.timeout(NOTIFICATION_TIMEOUT_MS)
+        response = await fetch_impl(
+            webhook_url,
+            options,
+        )
+        if not getattr(response, "ok", False):
+            logger.warning(
+                "BLT Chat notification failed for event %s with HTTP %s",
+                event_id,
+                getattr(response, "status", "unknown"),
+            )
+            return False
+    except Exception:
+        logger.exception("BLT Chat notification delivery raised for event %s", event_id)
+        return False
+
+    return True
+
+
+async def notify_triage_exported(db: Any, event: dict[str, Any], env: Any) -> bool:
+    """Load minimal exported-event context and send its notification."""
+    event_id = event["id"]
+    summary_row = (
+        await db.prepare("SELECT cwe_hints FROM triage_summaries WHERE triage_event_id = ?").bind(event_id).first()
+    )
+    duplicate_row = (
+        await db.prepare(
+            "SELECT candidate_event_id, similarity_score FROM duplicate_candidates "
+            "WHERE triage_event_id = ? AND llm_confirmed = 1 ORDER BY similarity_score DESC LIMIT 1"
+        )
+        .bind(event_id)
+        .first()
+    )
+    cwe_hints = _parse_cwe_hints(_get_value(summary_row, "cwe_hints"))
+    duplicate = None
+    if duplicate_row is not None:
+        duplicate = {
+            "candidate_event_id": _get_value(duplicate_row, "candidate_event_id"),
+            "similarity_score": _get_value(duplicate_row, "similarity_score"),
+        }
+    return await deliver_chat_notification(format_triage_notification(event, cwe_hints, duplicate), env, event_id)
+
+
+async def notify_quarantined(event: dict[str, Any], reason: str, env: Any) -> bool:
+    """Send a safe terminal-state notification for a quarantined event."""
+    return await deliver_chat_notification(format_quarantine_notification(event, reason), env, event["id"])
