diff --git a/blt-toasty/tests/test_notifier.py b/blt-toasty/tests/test_notifier.py
new file mode 100644
index 0000000000..616aaab169
--- /dev/null
+++ b/blt-toasty/tests/test_notifier.py
@@ -0,0 +1,167 @@
+"""Unit tests for the privacy-safe BLT Chat terminal-state notifier."""
+
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from src.notifier import (
+    NOTIFICATION_TIMEOUT_MS,
+    deliver_chat_notification,
+    format_quarantine_notification,
+    format_triage_notification,
+    notify_triage_exported,
+)
+
+
+EVENT = {"id": "evt-123", "project_id": 42, "issue_iid": 99}
+
+
+def _all_text(payload: dict) -> str:
+    return json.dumps(payload)
+
+
+def test_triage_payload_includes_requested_fields_without_issue_content():
+    payload = format_triage_notification(
+        EVENT,
+        ["CWE-79", "CWE-89"],
+        {"candidate_event_id": "evt-existing", "similarity_score": 0.9123},
+    )
+
+    text = _all_text(payload)
+    assert payload["text"].startswith("#### Toasty triage completed")
+    assert set(payload) == {"text"}
+    assert "CWE-79, CWE-89" in text
+    assert "unknown (not assessed)" in text
+    assert "evt-existing" in text
+    assert "0.91" in text
+    assert "executive_summary" not in text
+    assert "raw_payload" not in text
+
+
+def test_triage_payload_reports_no_confirmed_duplicate():
+    payload = format_triage_notification(EVENT, [], None)
+
+    assert "**Duplicate finding:** none" in payload["text"]
+    assert "**CWE:** unknown" in payload["text"]
+
+
+@pytest.mark.parametrize(
+    ("reason", "expected"),
+    [
+        ("Residual PII after Markdown stripping: 1 entities (EMAIL_ADDRESS)", "Residual PII detected"),
+        ("Entity EMAIL_ADDRESS at [0:1] has confidence 0.20 < threshold 0.70", "PII confidence below threshold"),
+        ("Unexpected error during redaction: secret admin@example.com", "Safety check failed"),
+    ],
+)
+def test_quarantine_payload_sanitizes_stored_reason(reason, expected):
+    payload = format_quarantine_notification(EVENT, reason)
+    text = _all_text(payload)
+
+    assert "PII / safety quarantine" in text
+    assert expected in text
+    assert "admin@example.com" not in text
+    assert "secret " not in text
+
